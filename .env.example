# OpenAI
OPENAI_API_KEY=sk-...

# Postgres
POSTGRES_DSN=postgresql+asyncpg://agentops:agentops@localhost:5432/agentops

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenTelemetry collector endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# App
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated allowed CORS origins (use * for local dev)
CORS_ORIGINS=*
# Optional: set to require X-API-Key header on all requests
API_KEY=
